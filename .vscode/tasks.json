{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Space Vanguard",
      "command": "gcc",
      "args": [
        "-O2",
        "-std=c11",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "-lwinmm",
        "-luser32"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiler: gcc with -lwinmm -luser32"
    }
  ]
}
